# Public Supabase configuration (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public HTTPS destination used by confirmation and password-recovery emails.
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://webvault.site

# Server-only: required by the Stripe webhook to update subscription fields.
# Never expose this key in client-side code or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only OpenAI credentials for PRO ChatGPT search.
# Keep the API key in the server environment only; never expose it as NEXT_PUBLIC_*.
OPENAI_API_KEY=sk-...
# Optional override. gpt-6-luna is the default low-cost search model.
OPENAI_SEARCH_MODEL=gpt-6-luna

# Server-only Stripe credentials
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The two verified non-secret plan IDs are maintained in lib/stripe-prices.ts.
# Pricing and the Checkout allow-list share that configuration. Legacy
# STRIPE_PRICE_* and NEXT_PUBLIC_STRIPE_PRICE_* values are not used.

# Owner notifications for successful WebVault PRO purchases, renewals, and cancellations.
# Add a Resend key and a verified sender address in Vercel before enabling these.
OWNER_NOTIFICATION_EMAIL=tneykov@gmail.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=WebVault <notifications@webvault.site>
