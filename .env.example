# Public Supabase configuration (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public HTTPS destination used by confirmation and password-recovery emails.
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://webvault.site

# Server-only: required by the Stripe webhook to update subscription fields.
# Never expose this key in client-side code or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only Stripe credentials
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from the two recurring Stripe products.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Price IDs are safe to expose. The API still validates them against the
# server-only values above before creating a Checkout Session.
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_...

# Owner notifications for successful WebVault PRO purchases, renewals, and cancellations.
# Add a Resend key and a verified sender address in Vercel before enabling these.
OWNER_NOTIFICATION_EMAIL=tneykov@gmail.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=WebVault <notifications@webvault.site>
